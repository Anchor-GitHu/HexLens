<!--
  控件样式与图标。颜色一律用 DynamicResource 引用主题令牌，换主题即时生效。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 字体与尺寸 ─────────────────────────────────────────────── -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, PingFang SC, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, Courier New, monospace</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="WindowRadius">0</sys:Double>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="SurfaceRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <Thickness x:Key="CardPadding">10,8</Thickness>

    <!-- ── 图标几何 ───────────────────────────────────────────────── -->
    <Geometry x:Key="Icon.Folder">M3,6.5 A1,1 0 0 1 4,5.5 L9,5.5 L11,7.5 L20,7.5 A1,1 0 0 1 21,8.5 L21,18 A1,1 0 0 1 20,19 L4,19 A1,1 0 0 1 3,18 Z</Geometry>
    <Geometry x:Key="Icon.Save">M4,4.5 L16.5,4.5 L19.5,7.5 L19.5,19.5 L4,19.5 Z M8,4.5 L8,10 L15.5,10 L15.5,4.5 M7,19.5 L7,13.5 L17,13.5 L17,19.5</Geometry>
    <Geometry x:Key="Icon.Search">M10.5,4.5 A6,6 0 1 1 10.49,4.5 M15,15 L20,20</Geometry>
    <Geometry x:Key="Icon.Moon">M20,14.5 A8.5,8.5 0 0 1 9.5,4 A8.5,8.5 0 1 0 20,14.5 Z</Geometry>
    <Geometry x:Key="Icon.Sun">M12,8 A4,4 0 1 1 11.99,8 M12,2.5 L12,5 M12,19 L12,21.5 M2.5,12 L5,12 M19,12 L21.5,12 M5.2,5.2 L7,7 M17,17 L18.8,18.8 M18.8,5.2 L17,7 M7,17 L5.2,18.8</Geometry>
    <Geometry x:Key="Icon.Minimize">M5,12 L19,12</Geometry>
    <Geometry x:Key="Icon.Maximize">M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z</Geometry>
    <Geometry x:Key="Icon.Restore">M7.5,7.5 L18,7.5 L18,18 L7.5,18 Z M5.5,15.5 L5.5,5.5 L15.5,5.5</Geometry>
    <Geometry x:Key="Icon.Close">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
    <Geometry x:Key="Icon.ChevronRight">M9.5,6 L15.5,12 L9.5,18</Geometry>
    <Geometry x:Key="Icon.ChevronDown">M6,9.5 L12,15.5 L18,9.5</Geometry>
    <Geometry x:Key="Icon.Export">M12,3.5 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M4,20 L20,20</Geometry>
    <Geometry x:Key="Icon.Hash">M7,4 L5.5,20 M14,4 L12.5,20 M4.5,9 L19,9 M3.5,15 L18,15</Geometry>
    <Geometry x:Key="Icon.Layers">M12,3.5 L21,8 L12,12.5 L3,8 Z M3,12.5 L12,17 L21,12.5 M3,16.5 L12,21 L21,16.5</Geometry>
    <Geometry x:Key="Icon.Eye">M2.5,12 C5,7.5 8.5,5.5 12,5.5 C15.5,5.5 19,7.5 21.5,12 C19,16.5 15.5,18.5 12,18.5 C8.5,18.5 5,16.5 2.5,12 Z M12,9 A3,3 0 1 1 11.99,9</Geometry>
    <Geometry x:Key="Icon.Wave">M3,12 L5,12 L6.5,7 L8.5,17 L10.5,9.5 L12.5,14.5 L14.5,5.5 L16.5,18 L18,12 L21,12</Geometry>
    <Geometry x:Key="Icon.Text">M5,5.5 L19,5.5 M12,5.5 L12,18.5 M9,18.5 L15,18.5</Geometry>
    <Geometry x:Key="Icon.Chart">M4,20 L4,10 M10,20 L10,4 M16,20 L16,13 M22,20 L22,7</Geometry>
    <Geometry x:Key="Icon.Copy">M8.5,8.5 L19,8.5 L19,19 L8.5,19 Z M5.5,15 L5,15 L5,5 L15,5 L15,5.5</Geometry>
    <Geometry x:Key="Icon.Check">M5,12.5 L10,17.5 L19,6.5</Geometry>

    <!-- ── 细滚动条（floral 同款：4-6px，无轨道，圆头）──────────── -->
    <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarLineButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="{DynamicResource InkGhostBrush}"
                                                    CornerRadius="3" Margin="2,0" Opacity="0.75" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarLineButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 按钮 ───────────────────────────────────────────────────── -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PaperDeepBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口控制按钮（关闭时变赤陶） -->
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PaperDeepBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0443E" />
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字按钮（工具条用） -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PaperDeepBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（竹绿） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource BambooBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BambooLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 分段切换（视图切换，floral 的滑动按钮组）──────────────── -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkGhostBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloudBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource BambooBrush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 线索卡片（对应 floral 的笔记卡片）────────────────────── -->
    <Style x:Key="ClueCardItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="{StaticResource CardRadius}" Background="Transparent"
                            Margin="6,1" Padding="{StaticResource CardPadding}">
                        <Grid>
                            <Border x:Name="Accent" Width="2.5" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="Transparent" Margin="-7,2,0,2" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource BambooBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文件/发现列表项（左栏下半部分） -->
    <Style x:Key="PlainListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource ClueCardItem}" />

    <!-- ── 文本 ───────────────────────────────────────────────────── -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    </Style>

    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    </Style>

    <!-- ── 输入框 ─────────────────────────────────────────────────── -->
    <Style x:Key="PlainTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BambooBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BambooGlowBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 结构树 ─────────────────────────────────────────────────── -->
    <Style x:Key="TreeExpandToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow" Data="{StaticResource Icon.ChevronRight}" Stretch="Uniform"
                              Width="7" Height="7" Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="{StaticResource Icon.ChevronDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StructureTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource TreeExpandToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PaperWarmBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 徽章（线索类别） -->
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource BambooBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <!-- ── 右键菜单 ────────────────────────────────────────────────────────
         默认的 WPF 菜单是系统灰白方角，跟这套纸感界面明显是两套语言。
         这里统一成：纸色底 + 细边框 + 10px 圆角 + 淡墨字 + 竹青悬停高亮。
         （这三个样式不带 x:Key，是隐式样式，会自动应用到全应用所有菜单。） -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin 留给阴影，否则阴影会被裁掉 -->
                    <Border CornerRadius="10" Margin="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                              Opacity="0.16" Color="#3D3D38" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="6" Margin="1,0" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource InkGhostBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource BambooGlowBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,5" Background="{DynamicResource BorderSubtleBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 垂直滚动条（加粗版）─────────────────────────────────────────────
         默认 WPF 滚动条约 10px、滑块更窄，在高分屏上很难点中。
         这里做成 16px 宽 + 圆角滑块 + 悬停泛竹青，和纸感界面一致。 -->
    <Style x:Key="HexScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <!-- ⚠️ 垂直 ScrollBar 里 Thumb 的 MinHeight **会被 Track 覆盖**（Track 自己按比例算尺寸）。
                                     所以最小值只能加在**内容**上，并让内容溢出显示：
                                     ClipToBounds=False + MinHeight → 视觉上是个好看的胶囊，
                                     而滚动比例完全不受影响（溢出的部分不可点，但整条轨道都能点着翻页）。 -->
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid ClipToBounds="False">
                                                <!-- CornerRadius 取宽度的一半 → 两头圆的胶囊 -->
                                                <Border x:Name="ThumbBd" CornerRadius="9" Margin="3,0"
                                                        MinHeight="44" VerticalAlignment="Stretch"
                                                        Background="{DynamicResource InkGhostBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background"
                                                            Value="{DynamicResource BambooBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background"
                                                            Value="{DynamicResource BambooBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <!-- 上下翻页区：保持可点击，但视觉上完全透明 -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
