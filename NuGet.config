<?xml version="1.0" encoding="utf-8"?>
<!--
  HexLens 本身只依赖 .NET SDK 自带的框架（WPF + BCL），不需要任何 NuGet 包。
  这里的源配置有两个用途：
    1. 不访问在线源 —— 离线环境下 restore 不会卡在 nuget.org；
    2. "local" 指向仓库内的 local-packages 目录 —— 手工下载的 .nupkg
       （例如自包含发布所需的 Microsoft.NETCore.App.Runtime.win-x64）丢进去即可当本地源用。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="local-packages" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
